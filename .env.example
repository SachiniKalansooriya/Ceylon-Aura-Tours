# Database — SQLite for dev, switch to MySQL for Hostinger production
DATABASE_URL="file:./dev.db"
# For Hostinger production, use:
# DATABASE_URL="mysql://username:password@host:3306/database_name"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-string-here-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials (used by seed script)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-this-password"

# WhatsApp Business number (with country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER="94XXXXXXXXX"

# Site config
NEXT_PUBLIC_SITE_NAME="Ceylon Aura Tours"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Email for admin password recovery codes (Gmail: use an App Password, not your normal password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS=""
